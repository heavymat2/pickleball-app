{
  "name": "feelgood-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bookkeeping and CRM for Feelgood Kurmann",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "fgos": "node --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types src/cli.ts",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
